# --------------------------------------------------------------------------
# THIS FILE IS AUTOGENERATED - DO NOT EDIT MANUALLY
#
# Source: Containerfile.j2
# --------------------------------------------------------------------------

ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PACKAGES="ca_root_nss"
ARG APP_VERSION=""
ARG UPSTREAM_URL="https://api.github.com/repos/pocket-id/pocket-id/releases/latest"
ARG UPSTREAM_JQ=".tag_name"
# FreeBSD fetch(1) exits 1 on /healthz's 204 No Content; OIDC discovery returns 200.
ARG HEALTHCHECK_ENDPOINT="http://127.0.0.1:1411/.well-known/openid-configuration"

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

LABEL org.opencontainers.image.title="Pocket ID" \
      org.opencontainers.image.description="Simple OpenID Connect and OAuth 2.0 provider that lets users sign in to your applications with passkeys." \
      org.opencontainers.image.source="https://github.com/daemonless/pocket-id" \
      org.opencontainers.image.url="https://pocket-id.org/" \
      org.opencontainers.image.documentation="https://pocket-id.org/docs" \
      org.opencontainers.image.licenses="BSD-2-Clause" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Infrastructure" \
      io.daemonless.port="1411" \
      io.daemonless.volumes="/config" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
      io.daemonless.packages="${PACKAGES}"

# Install root certificates for outbound OIDC, SMTP, and MaxMind HTTPS calls
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Download and verify the official Pocket ID FreeBSD release binary
RUN set -eux; \
    VERSION="${APP_VERSION}"; \
    if [ -z "${VERSION}" ]; then \
        VERSION=$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${UPSTREAM_JQ}"); \
    fi; \
    test -n "${VERSION}" && [ "${VERSION}" != "null" ]; \
    case "${FREEBSD_ARCH}" in \
        aarch64) BIN_ARCH="arm64" ;; \
        *) BIN_ARCH="${FREEBSD_ARCH}" ;; \
    esac; \
    ASSET="pocket-id_freebsd_${BIN_ARCH}"; \
    BASE_DL="https://github.com/pocket-id/pocket-id/releases/download/${VERSION}"; \
    fetch -qo "/tmp/${ASSET}" "${BASE_DL}/${ASSET}"; \
    fetch -qo /tmp/checksums.txt "${BASE_DL}/checksums.txt"; \
    EXPECTED_SHA=$(awk -v f="${ASSET}" '$2 == f { print $1 }' /tmp/checksums.txt); \
    ACTUAL_SHA=$(sha256 -q "/tmp/${ASSET}"); \
    test -n "${EXPECTED_SHA}" && [ "${EXPECTED_SHA}" = "${ACTUAL_SHA}" ]; \
    install -m 0755 "/tmp/${ASSET}" /usr/local/bin/pocket-id; \
    mkdir -p /app /config/data; \
    printf '%s\n' "${VERSION}" > /app/version; \
    chown -R bsd:bsd /config; \
    rm -f "/tmp/${ASSET}" /tmp/checksums.txt

COPY root/ /
RUN chmod +x /daemonless/libexec/pocket-id

WORKDIR /config
CMD ["/daemonless/libexec/pocket-id"]

EXPOSE 1411
VOLUME /config
# CLIs run as the app user under podman exec (x-daemonless.cli)
RUN daemonless-cli --install pocket-id
